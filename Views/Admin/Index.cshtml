
@model IEnumerable<BookHaven.Models.Book>

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h1>BookHaven Admin Dashboard</h1>
    <p>Manage your online bookstore.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="row mt-4">
        <div class="col-md-3 mb-3">
            <div class="card p-3 shadow-sm">
                <h5>Total Books</h5>
                <h2>@ViewBag.TotalBooks</h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card p-3 shadow-sm">
                <h5>Categories</h5>
                <h2>@ViewBag.TotalCategories</h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card p-3 shadow-sm">
                <h5>Active Books</h5>
                <h2>@ViewBag.ActiveBooks</h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card p-3 shadow-sm">
                <h5>Total Orders</h5>
                <h2>@ViewBag.TotalOrders</h2>
            </div>
        </div>
    </div>

    <hr />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Book Management</h3>

        <a asp-controller="Admin" asp-action="Create"
           class="btn btn-primary">
            Add New Book
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.Category?.Name</td>
                        <td>₦@book.Price.ToString("N2")</td>

                        <td>
                            @(book.IsActive ? "Active" : "Inactive")
                        </td>

                        <td>
                            <a asp-controller="Admin"
                               asp-action="Edit"
                               asp-route-id="@book.Id"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-controller="Admin"
                               asp-action="Delete"
                               asp-route-id="@book.Id"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
