
@model BookHaven.Models.Book

@{
    ViewData["Title"] = "Delete Book";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow p-4">

                <h2 class="text-danger mb-3">Delete Book</h2>

                <p>
                    Are you sure you want to delete this book?
                </p>

                <hr />

                <h4>@Model.Title</h4>

                <p><strong>Author:</strong> @Model.Author</p>

                <p>
                    <strong>Category:</strong>
                    @Model.Category?.Name
                </p>

                <p>
                    <strong>Price:</strong>
                    ₦@Model.Price.ToString("N2")
                </p>

                <div class="alert alert-warning">
                    If this book is part of an existing order,
                    it will be deactivated instead of permanently deleted
                    to preserve order history.
                </div>

                <form asp-controller="Admin"
                      asp-action="DeleteConfirmed"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        Yes, Delete Book
                    </button>

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </form>

            </div>
        </div>
    </div>
</div>
