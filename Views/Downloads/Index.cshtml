
@model IEnumerable<BookHaven.Models.Book>

@{
    ViewData["Title"] = "My Downloads";
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <h2 class="mb-2">My Downloads</h2>
    @if (ViewBag.PaymentSuccess == true)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        <strong>Payment Successful!</strong>
        Your purchase is complete. You can now download your books.

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}
    <p class="text-muted mb-4">
        Access the PDF books you have successfully purchased.
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm p-4 text-center">
            <h5>No purchased books available yet.</h5>
            <p class="text-muted">
                Your books will appear here after successful payment.
            </p>

            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-primary mt-2">
                Browse Books
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var book in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">

                        <img src="@book.CoverImage"
                             class="card-img-top"
                             alt="@book.Title"
                             style="height:250px; object-fit:contain;" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@book.Title</h5>

                            <p class="text-muted">
                                By @book.Author
                            </p>

                            <span class="badge bg-success mb-3">
                                Purchased
                            </span>

                            <a asp-controller="Downloads"
                               asp-action="Download"
                               asp-route-bookId="@book.Id"
                               class="btn btn-primary mt-auto">
                                Download PDF
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
