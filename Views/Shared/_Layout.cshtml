
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CDN</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark book-navbar">
        <div class="container">

            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <span class="brand-icon">CDN</span>
                <span>
                    CHRIST DOMINION NETWORK
                    <small class="d-block" style="font-size: 10px; letter-spacing: 2px;">
                        READ • LEARN • GROW
                    </small>
                </span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav mx-auto gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Books" asp-action="Index">Books</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/#about">About</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/#contact">Contact</a>
                    </li>
                </ul>

              

@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-controller="Cart" asp-action="Index"
       class="btn cart-nav-btn">
        <span>Cart</span>
        <span class="cart-count" id="cartCount">0</span>
    </a>

    <a asp-controller="Downloads" asp-action="Index"
       class="btn btn-outline-light ms-lg-2 mt-2 mt-lg-0">
        My Downloads
    </a>

    <form asp-controller="Account" asp-action="Logout"
          method="post" class="ms-lg-2 mt-2 mt-lg-0">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-light">
            Logout
        </button>
    </form>
}
else
{
    <a asp-controller="Account" asp-action="Login"
       class="btn btn-outline-light ms-lg-2 mt-2 mt-lg-0">
        Login
    </a>

    <a asp-controller="Account" asp-action="Register"
       class="btn btn-light ms-lg-2 mt-2 mt-lg-0">
        Register
    </a>
}

            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="book-footer" id="contact">
        <div class="container">
            <div class="row gy-4">

                <div class="col-md-6">
                    <h3>CDN - CHRIST DOMINION NETWORK</h3>
                    <p>Your trusted e-book store. Read, Learn and Grow.</p>
                </div>

                <div class="col-md-6 text-md-end">
                    <p>Knowledge for a Greater Life.</p>
                    <p>&copy; @DateTime.Now.Year CDN - CHRIST DOMINION NETWORK. All rights reserved.</p>
                </div>

            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
